# Secrets (CLAUDE_ORG_ID, TELEGRAM_BOT_TOKEN, etc). This repo is public,
# never commit it.
.env
.env.local

# Stale now that watch.py has no watchlist-file reader -- kept ignored
# because it's still personal data (which tickers someone watches), not
# because anything reads it.
watchlist.json

# The discovery engine's local store: a cache of collected items and their
# scores, rebuildable by re-running. interests.json IS committed.
discovery.db
discovery.db-shm
discovery.db-wal

# Inbound derived artifact published by the ai repo's personal_state.py
# (see discovery/personal_state.py). Never produced or committed here.
personal_state.json

__pycache__/
*.pyc
.venv/

# Engine-lab run artifacts: full prompt/response logs and per-experiment state.
# The lab code and LAB.md ARE committed; what a run produced stays local.
experiments/**/runs.jsonl
experiments/**/state.json
experiments/lab/artifacts/

# Per-job stdout/stderr from the installed Scheduled Tasks (see
# ops/install_tasks.py, ops/run.cmd). Inbound-only, never committed.
logs/
