# Copy to .env (gitignored) and fill in.

# --- watch.py (watchlist price alerter) -------------------------------------

# ntfy topic to push alerts to. Treat this like a password: anyone who knows
# the topic string can read your notifications and send to them.
NTFY_TOPIC=

# Optional: self-hosted ntfy server. Defaults to https://ntfy.sh
NTFY_BASE=

# --- discovery engine (python -m app) ---------------------------------------

# From https://console.anthropic.com/settings/keys -- used for scoring and for
# the web_search collector. Required unless DISCOVERY_PROVIDER says otherwise.
ANTHROPIC_API_KEY=

# Only needed with DISCOVERY_PROVIDER=openai (and `pip install openai`).
# That provider has no web search, so the web_search collector is skipped.
OPENAI_API_KEY=

# Telegram bot token from @BotFather and the chat id allowed to receive pushes.
# Leave empty to have the engine print pushes to stdout instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown).
# DISCOVERY_PROVIDER=anthropic          # anthropic | openai
# DISCOVERY_MODEL=claude-opus-5         # gpt-5 when the provider is openai
# DISCOVERY_DB=discovery.db
# DISCOVERY_INTERESTS=interests.json
# DISCOVERY_MAX_ITEMS=8
# DISCOVERY_INTERVAL=3600

# Pre-filter thresholds: how weak an interest match, and how little text, is
# still worth paying for an LLM call.
# DISCOVERY_MIN_MATCH=0.25
# DISCOVERY_MIN_TEXT_CHARS=120
