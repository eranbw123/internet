# Copy to .env (gitignored) and fill in.

# --- discovery engine (python -m app) ---------------------------------------

# The default provider (claude_chat) drives claude.ai inside an
# already-authenticated Chrome tab -- no API key. It needs:
#   1. Chrome running with --remote-debugging-port=9222
#   2. a claude.ai tab logged in inside that Chrome window
#   3. your claude.ai organization id below (visible in claude.ai URLs and
#      /api requests after logging in)
CLAUDE_ORG_ID=

# Port of the Chrome DevTools endpoint above (default 9222).
# CLAUDE_BROWSER_PORT=9222

# DISCOVERY_PROVIDER=chatgpt_browser drives chatgpt.com the same way -- no
# API key, no CLAUDE_ORG_ID, just a logged-in chatgpt.com tab in the same
# Chrome. Uses CHATGPT_BROWSER_PORT if set, else CLAUDE_BROWSER_PORT, else 9222.
# CHATGPT_BROWSER_PORT=9222

# Only needed with DISCOVERY_PROVIDER=anthropic (direct API, pay-per-token;
# from https://console.anthropic.com/settings/keys).
# ANTHROPIC_API_KEY=

# Only needed with DISCOVERY_PROVIDER=openai (and `pip install openai`).
# That provider has no web search, so the web_search collector is skipped.
OPENAI_API_KEY=

# YouTube Data API v3 key (console.cloud.google.com -- enable "YouTube Data
# API v3", create an API key). Only needed if an interest lists "youtube" in
# its sources (used to verify/enrich LLM-discovered videos). Transcripts
# additionally need `pip install youtube-transcript-api` (no key for that).
YOUTUBE_API_KEY=

# Telegram bot token from @BotFather and the chat id allowed to receive pushes.
# Leave empty to have the engine print pushes to stdout instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (defaults shown).
# DISCOVERY_PROVIDER=claude_chat        # claude_chat | chatgpt_browser | anthropic | openai
# DISCOVERY_MODEL=claude-opus-5         # gpt-5 (openai) | latest-high (chatgpt_browser sentinel, resolved live) | a bare slug | slug:effort to pin
# DISCOVERY_DB=discovery.db
# DISCOVERY_INTERESTS=interests.json
# DISCOVERY_MAX_ITEMS=8
# DISCOVERY_MAX_SCORES=25               # hard cap on LLM scoring calls per cycle; the surplus waits for the next one

# `run`'s scheduler: per-collector cadence (seconds) plus a once-daily
# Discovery digest. Alerts (today: stocks market_event) always send
# immediately and ignore the digest entirely.
# DISCOVERY_INTERVAL_STOCKS=3600
# DISCOVERY_INTERVAL_WEB=14400
# DISCOVERY_INTERVAL_YOUTUBE=14400
# DISCOVERY_DIGEST_TIME=08:00           # local HH:MM
# DISCOVERY_DIGEST_MAX=10               # Discovery items per digest, highest score first

# Pre-filter thresholds: how weak an interest match, and how little text, is
# still worth paying for an LLM call.
# DISCOVERY_MIN_MATCH=0.25
# DISCOVERY_MIN_TEXT_CHARS=120
